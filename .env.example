# These values are read only by the backend. Never prefix secrets with VITE_.
GOOGLE_DRIVE_API_KEY=your_server_side_drive_api_key
GOOGLE_DRIVE_ROOT_FOLDER_URL=https://drive.google.com/drive/folders/your_public_folder_id
# Alternatively use GOOGLE_DRIVE_ROOT_FOLDER_ID and optional GOOGLE_DRIVE_ROOT_RESOURCE_KEY.
# The existing API_KEY_GOOGLE name is also accepted as a legacy key name.
